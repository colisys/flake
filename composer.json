{
  "name": "iescarro/flake",
  "description": "A minimal PHP microframework inspired by Express.js",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Flake\\": "src/"
    },
    "files": ["./helper.php"]
  },
  "authors": [
    {
      "name": "Ian",
      "email": "ian.escarro@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.0",
    "ext-sqlite3": "*"
  },
  "scripts": {
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "BASE_DIR=`pwd` php -S 0.0.0.0:8000 -t public"
    ]
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.92"
  }
}
