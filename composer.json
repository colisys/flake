{
  "name": "iescarro/flake",
  "description": "A minimal PHP microframework inspired by Express.js",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Flake\\": "src/"
    },
    "files": ["./helper.php"]
  },
  "authors": [
    {
      "name": "Ian",
      "email": "ian.escarro@gmail.com"
    }
